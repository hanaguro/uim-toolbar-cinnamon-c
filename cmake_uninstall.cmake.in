# cmake_uninstall.cmake.in

if(NOT DEFINED CMAKE_INSTALL_PREFIX)
    set(CMAKE_INSTALL_PREFIX "@CMAKE_INSTALL_PREFIX@")
endif()

message(STATUS "Uninstalling files from ${CMAKE_INSTALL_PREFIX}")

if(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")
    message(FATAL_ERROR "Cannot find install manifest: @CMAKE_BINARY_DIR@/install_manifest.txt")
endif()

file(READ "@CMAKE_BINARY_DIR@/install_manifest.txt" files)
string(REPLACE "\n" ";" files "${files}")

set(installed_dirs "")
foreach(file ${files})
    if(EXISTS "${file}")
        message(STATUS "Removing ${file}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E remove "${file}")
        get_filename_component(dir "${file}" DIRECTORY)
        list(APPEND installed_dirs "${dir}")
    else()
        message(STATUS "File not found: ${file}")
    endif()
endforeach()

# 空になったインストール先ディレクトリを削除する
# （中身が残っているディレクトリは削除しないので /etc/xdg/autostart 等は安全）
list(REMOVE_DUPLICATES installed_dirs)
foreach(dir ${installed_dirs})
    if(IS_DIRECTORY "${dir}")
        file(GLOB children "${dir}/*" "${dir}/.*")
        if(NOT children)
            message(STATUS "Removing empty directory ${dir}")
            execute_process(COMMAND "${CMAKE_COMMAND}" -E rm -rf "${dir}")
        endif()
    endif()
endforeach()
